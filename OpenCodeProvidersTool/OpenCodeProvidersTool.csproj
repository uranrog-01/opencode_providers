<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>OpenCodeProvidersTool</RootNamespace>
    <AssemblyName>OpenCodeProvidersTool</AssemblyName>
    <Version>1.0.0</Version>
    <Product>OpenCode Providers Tool</Product>
    <AssemblyTitle>OpenCode Providers Tool</AssemblyTitle>
    <Description>A free tool for the OpenCode app: edit providers, models and token limits in one window.</Description>
    <Company>zer0ne</Company>
    <Authors>zer0ne</Authors>
    <Copyright>Copyright (c) 2026 zer0ne</Copyright>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <!-- No OpenCodeConfigApp.exe.config sidecar: the exe must stand alone. -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <!-- DPI awareness so the custom-drawn UI stays crisp instead of being bitmap scaled. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Explorer/taskbar file icon (embedded Win32 resource; output stays a single exe). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against Newtonsoft, but do not copy it next to the exe: it is
         embedded below and loaded by the resolver in Program.cs, so the release
         folder holds a single file. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(NuGetPackageRoot)newtonsoft.json/13.0.3/lib/net45/Newtonsoft.Json.dll"
                      LogicalName="Newtonsoft.Json.dll" />
  </ItemGroup>

</Project>
