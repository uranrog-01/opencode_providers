<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>SelfTest</AssemblyName>
    <RootNamespace>SelfTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../OpenCodeProvidersTool/ConfigStore.cs" />
    <Compile Include="../OpenCodeProvidersTool/ConfigComments.cs" />
    <Compile Include="../OpenCodeProvidersTool/ModelCatalog.cs" />
    <Compile Include="../OpenCodeProvidersTool/ModelDiscovery.cs" />
    <Compile Include="../OpenCodeProvidersTool/SmartState.cs" />
  </ItemGroup>

</Project>
